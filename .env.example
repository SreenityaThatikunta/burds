# Copy to .env (git-ignored) only if you need to change a default. Never commit real keys.

# --- app (python app/app.py) -------------------------------------------------------------
# Model to load: a Hugging Face id or a local folder. Default: google/embeddinggemma-2
BURDS_MODEL=google/embeddinggemma-2
# Folder with demo_index.npz, taxa.csv and thumbs/. Default: the app/ folder
# BURDS_DATA=
# Species list, if not in BURDS_DATA. Default: $BURDS_DATA/taxa.csv
# BURDS_TAXA=
# Set to 1 for a temporary public *.gradio.live link, kept up for BURDS_HOURS hours
# BURDS_SHARE=
# BURDS_HOURS=3

# --- Kaggle pipeline (kaggle/*) -----------------------------------------------------------
# The kaggle CLI reads ~/.kaggle/kaggle.json, or these two variables:
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# kaggle/demo_data needs a free xeno-canto API key (https://xeno-canto.org/account). Store it as a
# Kaggle notebook secret named XENO_CANTO_KEY, not here: kernels can't read local env files.
# XENO_CANTO_KEY=
